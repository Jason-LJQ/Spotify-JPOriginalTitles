# Track product source, tests and installation tooling only.
*
!/.gitignore
!/README.md
!/screenshots/
!/screenshots/*.jpeg
!/screenshots/*.jpg
!/screenshots/*.png
!/jp-original-titles/
!/jp-original-titles/*.m
!/jp-original-titles/*.h
!/jp-original-titles/test/
!/jp-original-titles/test/*.m
!/jp-original-titles/test/*.h
!/jp-original-titles/test/*.py
!/jp-original-titles/tools/
!/jp-original-titles/tools/add_load_dylib.py

# Local research, release evidence and AI workflow files stay on disk.
/jp-original-titles/dist/
/analysis/
/analysis-*/
/jp-original-titles/releases/
/jp-original-titles/candidates/
**/[Pp][Rr][Oo][Gg][Rr][Ee][Ss][Ss].md
**/[Aa][Gg][Ee][Nn][Tt][Ss].md
**/[Cc][Ll][Aa][Uu][Dd][Ee].md
**/AGENTS.snapshot.md
**/README.snapshot.md
.idea/
.vscode/
.codex/
.claude/
.DS_Store
